# ============================================================
# SiapQuiz — Environment Template
# Salin ke .env lalu isi nilai rahasia. Semua nilai di sini DUMMY.
# Referensi: project-docs/09-ops/env-config.md
# ============================================================

# --- Inti aplikasi ---
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_BASE_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# --- Database ---
POSTGRES_USER=siapquiz
POSTGRES_PASSWORD=ganti-password-ini
POSTGRES_DB=siapquiz
DATABASE_URL=postgresql+asyncpg://siapquiz:ganti-password-ini@postgres:5432/siapquiz
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
POSTGRES_MAX_CONNECTIONS=150

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_MAX_MEMORY=256mb

# --- Keamanan & token ---
JWT_SECRET=dummy-ganti-dengan-32-byte-acak
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PARTICIPANT_TOKEN_TTL_HOURS=12
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BYOK_MASTER_KEY=dummy-32-byte-hex-ganti-ini

# --- Unggahan & batasan ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25
MAX_DOCUMENTS_PER_ORG=50
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.pptx,.txt

# --- RAG & embedding ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
HF_HOME=/data/hfcache
CHUNK_MAX_CHARS=500
CHUNK_OVERLAP_CHARS=50
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.35

# --- LLM & biaya ---
LLM_QUESTIONS_PER_CALL=5
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=2
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_BACKOFF_MAX_ATTEMPTS=5
GENERATION_CACHE_TTL_DAYS=30
DEFAULT_BUDGET_CAP_USD=0.50
USD_TO_IDR_RATE=16000

# --- Gate anti-halusinasi ---
GROUNDING_QUOTE_THRESHOLD=0.85
GROUNDING_ANSWER_OVERLAP_MIN=0.30
QUALITY_SCORE_THRESHOLD=70
PROMPT_VERSION=v1.0

# --- Sesi kuis ---
LEADERBOARD_BROADCAST_THROTTLE_MS=1000
WS_HEARTBEAT_INTERVAL_SECONDS=20
WS_IDLE_TIMEOUT_SECONDS=90
SESSION_MAX_PARTICIPANTS=300

# --- Rate limit ---
RATELIMIT_LOGIN=10/15minutes
RATELIMIT_GENERATION_JOB=20/hour
RATELIMIT_SESSION_JOIN=30/minute

# --- Observability (kosong = Sentry mati) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Produksi (khusus VPS) ---
DOMAIN=siapquiz.example.com
ACME_EMAIL=admin@example.com
